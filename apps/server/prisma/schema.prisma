generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  /** Full org: settings, API keys, users, all CRUD. */
  ORG_ADMIN
  /** Locations, circuits, tags CRUD; API debug read-only. */
  LOCATION_CIRCUIT
  /** Dashboard/reporting read-only; no admin, tags, keys, debug. */
  USER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         UserRole @default(USER)
  createdAt    DateTime @default(now())
}

/**
 * Server-side session store. Replaces the @fastify/session default in-memory store so
 * sessions survive process restarts, work across horizontally scaled instances, and can
 * be forcibly revoked (logout, password rotation, admin action). Row body is the JSON
 * payload as serialized by the store in apps/server/src/lib/sessionStore.ts.
 */
model Session {
  id        String   @id
  data      String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}

enum CircuitConnectivityKind {
  DIA
  BROADBAND
  SATELLITE
  CELLULAR_4G_5G
}

/** Which store-level local contact a circuit uses (if any). */
enum SiteLocalContactSlot {
  PRIMARY
  SECONDARY
}

model Site {
  id                String   @id @default(cuid())
  name              String
  merakiNetworkId   String?
  thousandEyesTag   String?
  lat               Float?
  lng               Float?
  /**
   * When true, `lat`/`lng` are authoritative for map pins and weather (user-set).
   * When false, latest Meraki snapshot device geo is preferred when present, else stored lat/lng.
   */
  locationLatLngManual Boolean @default(false)
  /** Optional city (or "City, ST") shown in site weather summary; overrides hyperlocal OpenWeather names. */
  city              String?
  /** Require Meraki WAN2 to be active or ready (secondary wired path). */
  expectWan2Healthy     Boolean  @default(false)
  /** Require Meraki cellular uplink to be active or ready (secondary or tertiary backup). */
  expectCellularHealthy Boolean  @default(false)
  /** Store local contact #1 — referenced by circuits via siteLocalContactSlot PRIMARY. */
  localContactPrimaryName   String?
  localContactPrimaryPhone  String?
  localContactPrimaryEmail  String?
  /** Store local contact #2 — referenced by circuits via siteLocalContactSlot SECONDARY. */
  localContactSecondaryName   String?
  localContactSecondaryPhone  String?
  localContactSecondaryEmail  String?
  displayOrder      Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  snapshots         MetricSnapshot[]
  circuits          Circuit[]

  @@index([merakiNetworkId])
}

/** Reusable speed tiers; link to connectivity kinds for filtering. Empty kinds = show for all types in UI. */
model CircuitSpeedPreset {
  id           String                    @id @default(cuid())
  label        String
  downloadMbps Int
  uploadMbps   Int?
  kinds        CircuitConnectivityKind[] @default([])
  sortOrder    Int                       @default(0)
  createdAt    DateTime                  @default(now())
  circuits     Circuit[]
}

/** Carrier / logical circuit tied to a store and a Meraki WAN-style interface. */
model Circuit {
  id                    String                  @id @default(cuid())
  siteId                String
  site                  Site                    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  connectivityKind      CircuitConnectivityKind
  providerName          String
  carrierCircuitId      String
  speedPresetId         String?
  speedPreset           CircuitSpeedPreset?     @relation(fields: [speedPresetId], references: [id], onDelete: SetNull)
  /** Free-text when not using a preset (e.g. \"35/5 Mbps\"). */
  customSpeedLabel      String?
  isSynchronous         Boolean                 @default(true)
  /** Use this store's primary or secondary local contact (set on Stores tab). */
  siteLocalContactSlot  SiteLocalContactSlot?
  /** Meraki uplink id: wan1, wan2, wan3, cellular, etc. */
  merakiInterface       String
  /** When set, match this MX/MG serial; otherwise first appliance in the snapshot is used. */
  merakiApplianceSerial String?
  notes                 String?
  displayOrder          Int                     @default(0)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  outageEvents          CircuitOutageEvent[]
  circuitEvents         CircuitEvent[]
  importIdempotencies   CircuitImportIdempotency[]

  @@index([siteId])
  @@index([connectivityKind])
  @@index([providerName])
}

/** Dedupes circuit bulk-import commits when clients retry with the same idempotency key per row. */
model CircuitImportIdempotency {
  id               String   @id @default(cuid())
  idempotencyKey   String   @unique
  circuitId        String
  circuit          Circuit  @relation(fields: [circuitId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())

  @@index([circuitId])
}

/** Derived from Meraki ingest when an interface moves from healthy to unhealthy (and close when it recovers). */
model CircuitOutageEvent {
  id                   String         @id @default(cuid())
  circuitId            String
  circuit              Circuit        @relation(fields: [circuitId], references: [id], onDelete: Cascade)
  detectedAt           DateTime       @default(now())
  startedAt            DateTime
  endedAt              DateTime?
  statusObserved       String
  clearedToStatus      String?
  source               String         @default("meraki_ingest")
  circuitEventsLinked  CircuitEvent[]

  @@index([circuitId, startedAt])
  @@index([startedAt])
}

/**
 * Carrier / WAN observations per circuit (Meraki ingest deltas).
 * kind examples: public_ip_change — tracks when the WAN public IP differs from the prior snapshot.
 */
model CircuitEvent {
  id                   String              @id @default(cuid())
  circuitId            String
  circuit              Circuit             @relation(fields: [circuitId], references: [id], onDelete: Cascade)
  detectedAt           DateTime            @default(now())
  kind                 String
  previousValue        String?
  newValue             String?
  relatedOutageEventId String?
  relatedOutageEvent   CircuitOutageEvent? @relation(fields: [relatedOutageEventId], references: [id], onDelete: SetNull)
  note                 String?
  source               String              @default("meraki_ingest")

  @@index([circuitId, detectedAt])
  @@index([detectedAt])
  @@index([kind])
}

model CredentialVault {
  id              String   @id @default(cuid())
  provider        String   @unique
  encryptedValue  String
  iv              String
  authTag         String
  last4           String?
  updatedAt       DateTime @updatedAt
}

model MetricSnapshot {
  id         String   @id @default(cuid())
  siteId     String?
  site       Site?    @relation(fields: [siteId], references: [id], onDelete: SetNull)
  source     String
  payload    Json
  capturedAt DateTime @default(now())

  @@index([capturedAt])
  @@index([siteId, capturedAt])
  @@index([source, capturedAt])
}

model IngestRun {
  id           String    @id @default(cuid())
  jobType      String
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  status       String
  errorSummary String?
}

model AdminSettings {
  id                     String  @id @default("singleton")
  lenses                 Json    @default("{}")
  retentionDays          Int     @default(90)
  heartbeatIntervalSec   Int     @default(300)
  pollIntervalMerakiSec  Int     @default(900)
  pollIntervalTESec      Int     @default(900)
  oidcEnabled            Boolean @default(false)
  oidcIssuerUrl          String?
  oidcClientId           String?
  googleMapsEnabled      Boolean @default(false)
  tlsCertPath            String?
  tlsKeyPath             String?
  sessionIdleTimeoutMin  Int     @default(60)
  /**
   * Max OpenWeather API calls per UTC day (map tiles, tile probe, integration test).
   * 0 disables all server-side OpenWeather usage. Default 1000 aligns with common free-tier guidance.
   */
  openWeatherDailyLimit  Int     @default(1000)
  /**
   * ThousandEyes account group id (`aid` query param). Set this to the TE account group that matches your
   * Meraki organization scope (see Admin → Tags → account groups, or TE `/account-groups`). When null, TE uses the token default account group.
   */
  thousandEyesAid        String?
}

/** Rolling counter per UTC calendar day for OpenWeather outbound calls. */
model OpenWeatherUsageDay {
  dayUtc    String @id
  callCount Int    @default(0)
}
