{
  "name": "@retail-dashboard/server",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node ../../scripts/prisma-generate.cjs && tsc",
    "start": "node dist/index.js",
    "db:generate": "node ../../scripts/prisma-generate.cjs",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate deploy --schema ./prisma/schema.prisma",
    "db:push": "dotenv -e ../../.env -- prisma db push --schema ./prisma/schema.prisma",
    "db:migrate:dev": "dotenv -e ../../.env -- prisma migrate dev --schema ./prisma/schema.prisma",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^12.0.1",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/session": "^11.1.0",
    "@fastify/static": "^8.0.4",
    "@prisma/client": "^6.19.3",
    "bcrypt": "^5.1.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "node-cron": "^3.0.3",
    "openid-client": "^6.1.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^22.10.5",
    "@types/node-cron": "^3.0.11",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.18.0",
    "prisma": "^6.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.21.0"
  }
}
