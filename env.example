# Copy to .env at repo root (or apps/server/.env — server loads from cwd upward).
# After copy, chmod 600 .env and confirm it is git-ignored.

# --- Database (Postgres or Supabase transaction pooler / direct) ---
DATABASE_URL="postgresql://user:password@localhost:5432/retail_dashboard?schema=public"

# --- Credential vault encryption ---
# REQUIRED. 32 characters minimum. A random 32-byte base64 value is strongly preferred
# over a passphrase. Generate on any OS with Node installed:
#     node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this value invalidates every row in the CredentialVault table. See
# docs/RUNBOOK_CREDENTIAL_ROTATION.md before rotating.
CREDENTIALS_MASTER_KEY="REPLACE_WITH_RANDOM_32_BYTE_BASE64_VALUE"

# STRONGLY RECOMMENDED on new installs. 16 characters minimum. Generate a second random
# value (different from CREDENTIALS_MASTER_KEY) with the same command. Prevents an
# attacker who grabs one DB dump from benefiting from precomputed rainbow tables built
# against the shared legacy salt.
# CREDENTIALS_SALT=""

# --- Session ---
# Long random string, 32+ characters. Used to sign session cookies.
SESSION_SECRET="generate-long-random-string-min-32-chars"

# --- Server ---
NODE_ENV=development
HOST=0.0.0.0
PORT=3001
# Public URL used for OIDC redirects (no trailing slash). Also seeds the browser-origin
# allow-list used by CORS and the Origin-guard CSRF layer.
PUBLIC_URL=http://localhost:3001
# Browser origin after SSO (dev usually http://localhost:5173 with the Vite proxy).
FRONTEND_URL=http://localhost:5173

# Optional: comma-separated extra origins for CORS / Origin-guard. Use for staging and
# preview deployments. Never set to "*" — the server explicitly rejects that.
# ALLOWED_ORIGINS="https://staging-api.example.com,https://preview-app.example.com"

# Set to true when running behind NGINX / ALB / Cloudflare / Caddy so that X-Forwarded-*
# headers from the proxy are trusted for req.ip (rate limiting) and req.protocol
# (secure-cookie detection).
# TRUST_PROXY=false

# --- HTTPS (optional; paths to PEM files) ---
# In production with HTTPS_ENABLED=true the session cookie switches to the __Host- prefix.
HTTPS_ENABLED=false
TLS_CERT_PATH=
TLS_KEY_PATH=

# --- OIDC / Cisco SSO (optional) ---
OIDC_ENABLED=false
OIDC_ISSUER_URL=
# Optional defense-in-depth: comma-separated list of origin values that are the only
# issuers the server will accept, even if an ORG_ADMIN changes the issuer in the admin UI.
# Leave empty to allow any public HTTPS issuer that passes the built-in SSRF guard.
# OIDC_ISSUER_ALLOWLIST="https://idp.example.com"
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_CALLBACK_PATH=/api/auth/oidc/callback

# --- Bootstrap admin (optional; only if no users exist) ---
# Password must satisfy the password policy (≥12 chars, not a common password).
# REMOVE these variables after the first successful login, then restart.
# ADMIN_BOOTSTRAP_EMAIL=admin@example.com
# ADMIN_BOOTSTRAP_PASSWORD=replace-with-passphrase-at-least-12-chars
