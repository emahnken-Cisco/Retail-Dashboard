# Copy to .env at repo root (or apps/server/.env — server loads from cwd upward)

# --- Database (Postgres or Supabase transaction pooler / direct) ---
DATABASE_URL="postgresql://user:password@localhost:5432/retail_dashboard?schema=public"

# --- Credential vault encryption (32-byte key, base64) ---
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_MASTER_KEY="REPLACE_WITH_BASE64_32_BYTES"

# --- Session ---
SESSION_SECRET="generate-long-random-string-min-32-chars"

# --- Server ---
NODE_ENV=development
HOST=0.0.0.0
PORT=3001
# Public URL used for OIDC redirects (no trailing slash)
PUBLIC_URL=http://localhost:3001

# --- HTTPS (optional; paths to PEM files) ---
HTTPS_ENABLED=false
TLS_CERT_PATH=
TLS_KEY_PATH=

# --- OIDC / Cisco SSO (optional) ---
OIDC_ENABLED=false
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_CALLBACK_PATH=/api/auth/oidc/callback

# --- Bootstrap admin (optional; only if no users exist) ---
# ADMIN_BOOTSTRAP_EMAIL=admin@example.com
# ADMIN_BOOTSTRAP_PASSWORD=change-me-on-first-login

# --- Frontend (post-OIDC redirect; dev usually http://localhost:5173) ---
FRONTEND_URL=http://localhost:5173
